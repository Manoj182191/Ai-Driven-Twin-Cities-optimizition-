# ==============================================================================
# AI-Driven Twin Cities Optimization - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your deployment.
# NEVER commit the real .env file or credentials to source control.

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend Development Server
VITE_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional External Data Ingestion Providers
# If left empty, the application operates in full synthetic and benchmark mode
PEMS_API_KEY=
PEMS_BASE_URL=https://pems.dot.ca.gov/api

# Optimization & Experiment Configuration
MAX_EXPERIMENT_WORKERS=4
DEFAULT_RANDOM_SEED=42
ENABLE_PERSISTENT_STORAGE=true
EXPERIMENT_STORAGE_DIR=backend/data/research_experiments
